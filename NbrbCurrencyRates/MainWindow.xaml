<Window x:Class="NbrbCurrencyRates.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
    xmlns:chart="clr-namespace:Telerik.Windows.Controls.ChartView;assembly=Telerik.Windows.Controls.Chart"
        Title="Курсы валют НБ РБ"
        Width="1200"
        Height="700"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="12">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Grid Grid.Row="0"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="Начало периода:" />

            <telerik:RadDatePicker Grid.Column="1"
                                   SelectedValue="{Binding StartDate,
                                       UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Column="2"
                       Margin="15,0,8,0"
                       VerticalAlignment="Center"
                       Text="Окончание периода:" />

            <telerik:RadDatePicker Grid.Column="3"
                                   SelectedValue="{Binding EndDate,
                                       UpdateSourceTrigger=PropertyChanged}" />

            <telerik:RadButton Grid.Column="4"
                               Margin="15,0,5,0"
                               Padding="12,5"
                               Content="Загрузить данные"
                               Command="{Binding LoadDataCommand}" />

            <telerik:RadButton Grid.Column="5"
                               Margin="5,0"
                               Padding="12,5"
                               Content="Открыть файл"
                               Command="{Binding LoadFileCommand}" />

            <telerik:RadButton Grid.Column="6"
                               Margin="5,0"
                               Padding="12,5"
                               Content="Сохранить изменения"
                               Command="{Binding SaveChangesCommand}" />

            <telerik:RadButton Grid.Column="7"
                               Margin="5,0,0,0"
                               Padding="12,5"
                               Content="Отмена"
                               Command="{Binding CancelCommand}" />
        </Grid>

        <!-- Индикатор загрузки -->
        <ProgressBar Grid.Row="1"
                     Height="4"
                     Margin="0,0,0,8"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy,
                         Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Редактируемый список курсов и график рядом -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <telerik:RadGridView Grid.Column="0"
                                 x:Name="RatesGrid"
                                 ItemsSource="{Binding Rates}"
                                 AutoGenerateColumns="False"
                                 IsReadOnly="False"
                                 CanUserInsertRows="False"
                                 CanUserDeleteRows="False"
                                 ShowGroupPanel="False"
                                 SelectedItem="{Binding SelectedRate, Mode=TwoWay}">

                <telerik:RadGridView.Columns>

                    <telerik:GridViewDataColumn Header="ID"
                                                DataMemberBinding="{Binding Cur_ID}"
                                                IsReadOnly="True"
                                                Width="80" />

                    <telerik:GridViewDataColumn Header="Дата"
                                                DataMemberBinding="{Binding Date,
                                                    StringFormat={}{0:yyyy-MM-dd}}"
                                                IsReadOnly="True"
                                                Width="130" />

                    <telerik:GridViewDataColumn Header="Код"
                                                DataMemberBinding="{Binding Cur_Code}"
                                                IsReadOnly="True"
                                                Width="80" />

                    <telerik:GridViewDataColumn Header="Валюта"
                                                DataMemberBinding="{Binding Cur_Abbreviation}"
                                                IsReadOnly="True"
                                                Width="100" />

                    <telerik:GridViewDataColumn Header="Наименование"
                                                DataMemberBinding="{Binding Cur_Name}"
                                                IsReadOnly="True"
                                                Width="220" />

                    <telerik:GridViewDataColumn Header="Масштаб"
                                                DataMemberBinding="{Binding Cur_Scale}"
                                                IsReadOnly="True"
                                                Width="100" />

                    <telerik:GridViewDataColumn Header="Официальный курс"
                                                DataMemberBinding="{Binding Cur_OfficialRate,
                                                    UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="False"
                                                Width="180" />

                </telerik:RadGridView.Columns>
            </telerik:RadGridView>


            <!-- Явно заменить использование NumericalAxis на chart:NumericalAxis -->
            <telerik:RadCartesianChart Grid.Column="1" x:Name="RatesChart">
                <telerik:RadCartesianChart.HorizontalAxis>
                    <telerik:DateTimeContinuousAxis LabelFormat="dd"
                                                      MaximumTicks="15" />
                </telerik:RadCartesianChart.HorizontalAxis>
                <!-- Vertical axis будет инициализирована в коде (MainWindow.xaml.cs) внутри безопасного try/catch,
                     чтобы уменьшить риск XamlParseException -->

                <chart:LineSeries ItemsSource="{Binding SelectedCurrencyRates}"
                                  CategoryBinding="Date"
                                  ValueBinding="Cur_OfficialRateValue" />
            </telerik:RadCartesianChart>
        </Grid>

        <!-- Статус -->
        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap" />

    </Grid>
</Window>
